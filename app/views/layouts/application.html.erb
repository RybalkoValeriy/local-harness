<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Local Harness" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Local Harness">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "harness", "appearance", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="appearance-bar">
      <%= link_to "Local Harness", projects_path, class: "appearance-brand" %>
      <label>Theme <select aria-label="Theme" data-controller="theme" data-action="change->theme#change"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></label>
    </div>
    <%= yield %>
  </body>
</html>
